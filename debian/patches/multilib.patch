 	if arch.DpkgArchitecture() == "amd64" && s.canCheckCompatArch {
-		cmd = exec.Command(cmd.Args[0], cmd.Args[1:]...)
-		cmd.Args = append(cmd.Args, "-m32")
+		cmd = exec.Command("i686-linux-gnu-gcc", cmd.Args[1:]...)
